# Connector settings: passed ONLY to the connectors container (docker-compose.yml env_file), never to the app.
# `make secrets-init` copies this to secrets/connectors.env once; edit that copy, then `docker compose up -d connectors`.
# duckduckgo | tavily | brave | searxng
WEB_SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
BRAVE_API_KEY=
SEARXNG_URL=
