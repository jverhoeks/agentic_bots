# Note: keep comments on their own lines; docker compose treats "KEY=  # text" as the value "# text".

# --- Models: LiteLLM, OpenAI (or any OpenAI-compatible server), Anthropic or OpenRouter ---
# LLM_PROVIDER serves bare model names; "<provider>:<model>" picks another configured provider per bot,
# e.g. BUILDER_MODEL=anthropic:claude-sonnet-5-5 or DEFAULT_BOT_MODEL=openrouter:openai/gpt-5.
# litellm | openai | anthropic | openrouter
LLM_PROVIDER=litellm
# LiteLLM proxy. In docker (make up-all), a LiteLLM on your host is http://host.docker.internal:<port>
LITELLM_BASE_URL=https://litellm.example.com
LITELLM_API_KEY=sk-...
# Direct providers: set the key of each one you use
OPENAI_API_KEY=
# empty = api.openai.com; or any OpenAI-compatible server, e.g. http://host.docker.internal:11434/v1 (Ollama)
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# model for the main (builder) session; needs tool calling
BUILDER_MODEL=claude-sonnet
# default model for new bots
DEFAULT_BOT_MODEL=claude-sonnet
# optional comma list; empty = everything the configured providers list (OpenRouter lists hundreds: set this)
ALLOWED_MODELS=
# bots' cron schedules (metadata.schedule) are in this time zone
SCHEDULE_TIMEZONE=UTC

# --- Tools: agentgateway (see gateway/config.yaml and config/mcp.json) ---
# host dev value; docker compose overrides it with the in-network address
AGENT_GATEWAY_URL=http://localhost:3000/mcp

# --- Connector settings: not here. The app container loads this file, so search keys go in
# secrets/connectors.env (connectors container only; `make secrets-init`, see connectors/connectors.env.example).

# --- Login: username/password, plus single sign-on when OIDC_* is set ---
# The first account registers itself in the UI and is the admin; after that only `make user USER_ID=<name>` adds users,
# unless ALLOW_SIGNUP=true. SESSION_SECRET signs the login cookie (empty = generated into data/).
SESSION_SECRET=
# COOKIE_SECURE=true when served over HTTPS
COOKIE_SECURE=false
ALLOW_SIGNUP=false

# Single sign-on with any OpenID Connect provider (Entra ID, Google, Keycloak, ...); empty = off.
# Register the redirect URL at the provider: dev http://localhost:4200/api/auth/oidc/callback,
# docker http://localhost:8080/api/auth/oidc/callback.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
# button label on the login page
OIDC_NAME=SSO

# --- Storage: SQLite by default; PostgreSQL via the `postgres` compose profile ---
# Password: POSTGRES_PASSWORD in secrets/postgres.env (random, generated once by `make secrets-init`)
# DATABASE_URL=postgresql+psycopg://bots:<password>@localhost:5432/bots

# --- Guardrails per agent turn (0 = no limit) ---
MAX_PROMPT_CHARS=20000
# a 10-story HN digest with comments uses ~500k tokens (the input is re-sent every step)
TURN_TOKEN_LIMIT=1500000
TURN_TOOL_CALL_LIMIT=60

# --- Tracing: every chat turn, run, tool, MCP and A2A call, per user and session ---
# Stored in the app database (Admin > Traces, and per message in the chat); TRACE_STORE=false turns that off.
# Optionally also sent to an OpenTelemetry collector (OTLP/HTTP), e.g. http://otel-collector:4318; empty = app DB only.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Prompts, answers, tool arguments and results in the spans (secrets redacted, values capped). They can hold
# e-mails and other personal data, readable by admins: false keeps only names, timings, tokens and errors.
TRACE_CONTENT=true
TRACE_MAX_ATTR_CHARS=20000
TRACE_RETENTION_DAYS=30

# --- Activity events: tool, LLM, MCP and A2A calls as CloudEvents (com.agenticbots.*.called) ---
# POSTed in batches (application/cloudevents-batch+json) to this URL, e.g. the lineage/quality service. Best effort.
EVENT_SINK_URL=
EVENT_SINK_TOKEN=
# Tool arguments and results in the events (redacted, capped). They leave the app: off by default.
EVENT_CONTENT=false
