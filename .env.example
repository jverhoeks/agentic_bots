# --- Models: your external LiteLLM proxy (OpenAI-compatible) ---
LITELLM_BASE_URL=https://litellm.example.com
LITELLM_API_KEY=sk-...
BUILDER_MODEL=claude-sonnet          # LiteLLM model alias for the main (builder) session
DEFAULT_BOT_MODEL=claude-sonnet      # default model for new bots
ALLOWED_MODELS=                      # optional comma list; empty = everything LiteLLM lists for this key

# --- Tools: agentgateway (see gateway/config.yaml and config/mcp.json) ---
AGENT_GATEWAY_URL=http://localhost:3000/mcp

# --- Connector settings (only passed to the connectors container) ---
WEB_SEARCH_PROVIDER=duckduckgo       # duckduckgo | tavily | brave | searxng
TAVILY_API_KEY=
BRAVE_API_KEY=
SEARXNG_URL=
